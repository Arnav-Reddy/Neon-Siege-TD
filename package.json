{
  "name": "neon-siege-td",
  "productName": "Neon Siege TD",
  "version": "1.0.6",
  "description": "Incremental tower defense that floats as an always-on-top desktop overlay.",
  "author": "Arnav V",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.arnavreddy.neonsiegetd",
    "productName": "Neon Siege TD",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build"
    },
    "afterPack": "./build/afterPack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "publish": {
      "provider": "github",
      "owner": "Arnav-Reddy",
      "repo": "Neon-Siege-TD",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
